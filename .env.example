# API Keys untuk AR Scanner
# Dapatkan API key di masing-masing provider:

# 1. Gemini (PRIMARY) — https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key

# 2. Groq (DISABLED — model decommissioned, no replacement)
# VITE_GROQ_API_KEY=your-groq-api-key

# 3. OpenRouter (FALLBACK 2-3) — https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=your-openrouter-api-key

# 4. Together AI (FALLBACK 5) — https://api.together.xyz/
VITE_TOGETHER_API_KEY=your-together-api-key

# 5. Hugging Face (FALLBACK 6) — https://huggingface.co/settings/token
VITE_HF_API_KEY=your-huggingface-api-key